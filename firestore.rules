rules_version = '2';

// =====================================================================
// Attendance System — Firestore Security Rules
//
// One institution, many departments. Every record carries departmentId
// (the department that owns it: a subject's records belong to the
// department that offers the subject).
//
// Who can do what (enforced by Google's servers, not by the app):
//   Institution Admin : creates departments; manages HOD and Principal
//              accounts (and can reset anyone's); institution settings;
//              closes days for the whole institution; reads everything.
//              Never creates or changes attendance.
//   Principal: reads everything. Changes nothing.
//   HOD      : everything for THEIR department: batches, subjects,
//              students, teachers, teacher/student accounts, closures,
//              correction decisions. Reads only their department's
//              attendance. Cannot create or change attendance records.
//   Teacher  : marks attendance ONCE per class per day, only for subjects
//              assigned to them, and only on a day the class could have
//              met (not Sunday, an institution or department closed day,
//              a class marked not held, a future date, or a semester that
//              is not ACTIVE); requests corrections; marks classes not held.
//   Student  : reads only their own student record and their own
//              attendance copies (studentViews), plus class-level data.
//
// Internal assessment (assessments, assessmentViews, assessmentLog): only the
// subject's teacher enters marks, and only while its semester is ACTIVE (the HOD
// reopening a semester unlocks it again). The HOD of the department may read.
// Each student reads only their own copy (assessmentViews). Every entry or
// change is logged in assessmentLog, which can't be changed or deleted.
//   Anyone not logged in: can only look up a login ID (to sign in).
//
// Students may set up their own login (no slips): roll number + date of birth
// activates it once, and they choose a password and a 4-digit PIN. Later,
// roll number + date of birth + PIN lets them choose a new password. The date of
// birth and PIN are kept only as SHA-256 hashes in studentSecrets, which nobody
// can read; these rules compare them with what the student typed.
//
// Saved attendance can never be deleted. The teacher who saved it may change
// the marks for a short time (Institution Admin's setting, default 60 minutes,
// never past midnight); the first-saved marks are kept, so every change shows.
// After that, changes go through correction requests approved by the HOD.
//
// Upgrading a single-department install: the existing HOD appoints the
// Institution Admin once (config/institution); the Admin then tags the
// old records with a department ("claim"). Old records without a
// department can't be used until then.
//
// Dates are the college's local (India, UTC+5:30) calendar dates.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function doc(collection, id) { return /databases/$(database)/documents/$(collection)/$(id); }
    function signedIn() { return request.auth != null; }
    function profilePath() { return doc("users", request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function isActive() { return hasProfile() && me().active == true; }
    function isAdmin() { return isActive() && me().role == "Admin"; }
    function isPrincipal() { return isActive() && me().role == "Principal"; }
    function isHod() { return isActive() && me().role == "HOD"; }
    function isTeacher() { return isActive() && me().role == "Teacher"; }
    function isStudent() { return isActive() && me().role == "Student"; }
    function isStaff() { return isHod() || isTeacher(); }
    function anyUser() { return isActive(); }
    function myDept() { return me().get("departmentId", ""); }

    // Whole-institution readers
    function seesAll() { return isAdmin() || isPrincipal(); }
    // HOD of department d
    function isHodOf(d) { return isHod() && d is string && d != "" && myDept() == d; }
    // May read department d's attendance-type records
    function canRead(d) { return seesAll() || (isStaff() && d is string && d != "" && myDept() == d); }
    // ...or check that one doesn't exist yet (e.g. today's attendance before it is saved)
    function canReadRecord() {
      return (resource == null && (isStaff() || seesAll()))
        || (resource != null && canRead(resource.data.get("departmentId", "")));
    }

    // HOD writes to a department-owned record: the record is (and stays) theirs
    function hodCreates() { return isHodOf(request.resource.data.get("departmentId", "")); }
    function hodUpdates() {
      return isHodOf(resource.data.get("departmentId", ""))
        && request.resource.data.get("departmentId", "") == resource.data.get("departmentId", "");
    }
    function hodDeletes() { return isHodOf(resource.data.get("departmentId", "")); }

    // Admin tags an old (pre-departments) record with a department; nothing else changes
    function claimsLegacy() {
      return isAdmin()
        && !("departmentId" in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["departmentId"])
        && request.resource.data.departmentId is string
        && exists(doc("departments", request.resource.data.departmentId));
    }

    // Is the logged-in teacher assigned to this subject?
    function teaches(subjectId) {
      return isTeacher()
        && subjectId is string
        && exists(doc("subjectAssignments", subjectId))
        && get(doc("subjectAssignments", subjectId)).data.teacherId == me().teacherId;
    }

    // ---------- One-time setup ----------
    function institutionPath() { return doc("config", "institution"); }
    function institutionSetUp() { return exists(institutionPath()); }
    function legacyInstall() { return exists(doc("config", "hod")); }
    // During setup: on a new install the person setting up becomes the
    // Admin; on an old single-department install only its HOD may appoint one.
    function setupAppoints(adminUid) {
      return signedIn()
        && !institutionSetUp()
        && getAfter(institutionPath()).data.adminUid == adminUid
        && ((!legacyInstall() && request.auth.uid == adminUid)
            || (legacyInstall() && get(doc("config", "hod")).data.uid == request.auth.uid));
    }

    // Could this class have met on this date? ("YYYY-MM-DD", already format-checked)
    function classCouldMeet(subjectId, date, dept) {
      let day = timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10]));
      let subject = get(doc("subjects", subjectId)).data;
      return subject.get("departmentId", "") == dept
        && day.dayOfWeek() != 7                                          // not a Sunday
        && day <= request.time + duration.value(330, "m")                // not in the future (India time)
        && !exists(doc("dayStatuses", date))                             // institution has not closed the day
        && !exists(doc("dayStatuses", dept + "_" + date))                // department has not closed the day
        && !exists(doc("classCancellations", subjectId + "_" + date))    // not marked "not held"
        && get(doc("batches", string(subject.batchId) + "_" + string(subject.semester))).data.status == "ACTIVE";
    }

    // A teacher's write to one student's attendance copy may add or change
    // exactly one date (field "last"), and only to match the saved record:
    //   days[last]   == that day's attendance for this student
    //   leaves[last] == the type of that day's leave for this student
    // Corrections are written by the HOD only.
    function teacherViewWriteOk(viewId, oldDays, oldLeaves, oldCorrections) {
      let v = request.resource.data;
      let days = v.get("days", {});
      let leaves = v.get("leaves", {});
      let last = v.get("last", "");
      let dayChanged = days.diff(oldDays).affectedKeys();
      let leaveChanged = leaves.diff(oldLeaves).affectedKeys();
      return teaches(v.subjectId)
        && v.studentId is string
        && last is string
        && viewId == v.studentId + "_" + v.subjectId
        && v.get("departmentId", "") == myDept()
        && v.keys().hasOnly(["studentId", "subjectId", "departmentId", "days", "leaves", "corrections", "last"])
        && v.get("corrections", {}) == oldCorrections
        && dayChanged.hasOnly([last])
        && leaveChanged.hasOnly([last])
        && (dayChanged.size() == 0
            || days[last] == getAfter(doc("attendance", v.subjectId + "_" + last)).data.records[v.studentId])
        && (leaveChanged.size() == 0
            || leaves[last] == get(doc("leaves", v.subjectId + "_" + last + "_" + v.studentId)).data.type);
    }

    // ---------- Students setting up their own login ----------
    // The student types roll number + date of birth (+ PIN to reset) into a note
    // (activationClaims/{their new uid}) written in the same save; checked here
    // against the hashes, then deleted by them.
    function claim() { return getAfter(doc("activationClaims", request.auth.uid)).data; }
    function stubOf(id) { return get(doc("activation", id)).data; }
    function secretOf(id) { return get(doc("studentSecrets", id)).data; }
    function dobOk(id) {
      return signedIn() && existsAfter(doc("activationClaims", request.auth.uid))
        && claim().roll == id && claim().dob is string
        && exists(doc("studentSecrets", id))
        && hashing.sha256(id + "|" + claim().dob).toHexString() == secretOf(id).dobHash;
    }
    // first time: not activated yet, date of birth matches
    function activates(id) { return dobOk(id) && stubOf(id).activated == false; }
    // forgot password: activated, date of birth and PIN match
    function resets(id) {
      return dobOk(id) && stubOf(id).activated == true && claim().pin is string
        && secretOf(id).get("pinHash", null) is string
        && hashing.sha256(id + "|" + claim().pin).toHexString() == secretOf(id).pinHash;
    }
    function selfSetup(id) { return activates(id) || resets(id); }
    // The student's own new profile, exactly as the activation record says
    function selfProfileOk(uid, p) {
      let id = p.loginId;
      let stub = stubOf(id);
      return uid == request.auth.uid
        && p.keys().hasOnly(["role", "name", "roll", "studentId", "studentDocId", "departmentId", "loginId", "active", "mustChangePassword", "createdAt", "activatedBy"])
        && p.role == "Student" && p.name == "" && p.active == true && p.mustChangePassword == false
        && p.studentDocId == stub.studentDocId && p.studentId == stub.studentId && p.departmentId == stub.departmentId
        && selfSetup(id)
        && getAfter(doc("loginNames", id)).data.uid == uid;
    }

    match /activation/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if hodCreates()
        && request.resource.data.keys().hasOnly(["studentDocId", "studentId", "departmentId", "activated", "hasPin"]);
      allow update: if (hodUpdates()
            && request.resource.data.keys().hasOnly(["studentDocId", "studentId", "departmentId", "activated", "hasPin", "activatedAt"]))
        || (activates(id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activated", "hasPin", "activatedAt"])
            && request.resource.data.activated == true && request.resource.data.hasPin == true
            && request.resource.data.activatedAt == request.time)
        // a student sets their PIN after logging in
        || (isStudent() && me().get("loginId", "") == id
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hasPin"])
            && request.resource.data.hasPin == true);
      allow delete: if hodDeletes();
    }
    match /studentSecrets/{id} {
      allow read: if false;
      allow create: if hodCreates()
        && request.resource.data.keys().hasOnly(["departmentId", "studentDocId", "dobHash", "pinHash"]);
      allow update: if (hodUpdates()
            && request.resource.data.keys().hasOnly(["departmentId", "studentDocId", "dobHash", "pinHash", "activatedAt", "activatedUid"])
            && (request.resource.data.get("pinHash", null) == null           // the HOD may clear a PIN or leave it, not set one
                || request.resource.data.get("pinHash", null) == resource.data.get("pinHash", null)))
        || (selfSetup(id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pinHash", "activatedAt", "activatedUid"])
            && request.resource.data.activatedUid == request.auth.uid
            && request.resource.data.activatedAt == request.time
            && (activates(id) ? request.resource.data.get("pinHash", null) is string
                              : request.resource.data.get("pinHash", null) == resource.data.get("pinHash", null)))
        || (isStudent() && me().get("loginId", "") == id
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pinHash"])
            && request.resource.data.pinHash is string);
      allow delete: if hodDeletes();
    }
    match /activationClaims/{uid} {
      allow read, update: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["roll", "dob", "pin", "at"])
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Institution ----------
    match /config/institution {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(["adminUid", "name", "createdAt"])
        && request.resource.data.adminUid is string
        && getAfter(doc("users", request.resource.data.adminUid)).data.role == "Admin"
        && setupAppoints(request.resource.data.adminUid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "migratedAt"]);
      allow delete: if false;
    }

    // Old single-department installs only (no longer created)
    match /config/hod {
      allow get: if true;
      allow write: if false;
    }

    match /config/settings {
      allow read: if anyUser();
      allow write: if isAdmin();
    }

    match /departments/{id} {
      allow read: if anyUser();
      allow write: if isAdmin();
    }

    // ---------- Accounts ----------
    // An HOD manages only Teacher and Student accounts of their own department.
    function hodManagesAccount(data) {
      return isHod()
        && data.get("departmentId", "") == myDept()
        && myDept() != ""
        && data.get("role", "") in ["Teacher", "Student"];
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin()
                                  || (isHod() && resource.data.get("departmentId", "") == myDept() && myDept() != ""));
      allow list: if isAdmin() || (isHod() && resource.data.get("departmentId", "") == myDept() && myDept() != "");
      allow create: if isAdmin()
        || hodManagesAccount(request.resource.data)
        || (request.resource.data.role == "Admin" && setupAppoints(uid))
        || (!hasProfile() && selfProfileOk(uid, request.resource.data));
      // A user may also clear their own "must change password" flag and
      // record their own recovery email.
      allow update: if isAdmin()
        || (hodManagesAccount(resource.data) && hodManagesAccount(request.resource.data))
        // a student resetting their own password retires their old login
        || (resource.data.role == "Student" && resets(resource.data.get("loginId", ""))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active"])
            && request.resource.data.active == false)
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword", "recoveryEmail"])
            && request.resource.data.mustChangePassword == false
            && request.resource.data.get("recoveryEmail", "") is string);
      allow delete: if isAdmin() || hodManagesAccount(resource.data);
    }

    // Login ID -> internal sign-in address. Needed before signing in,
    // so single lookups are public; listing all IDs is not allowed.
    match /loginNames/{loginId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        || hodCreates()
        || setupAppoints(request.resource.data.uid)
        || (activates(loginId) && request.resource.data.uid == request.auth.uid
            && request.resource.data.keys().hasOnly(["email", "uid", "departmentId"])
            && request.resource.data.departmentId == stubOf(loginId).departmentId);
      allow update: if isAdmin() || hodUpdates()
        || (resets(loginId) && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["email", "uid"]));
      allow delete: if isAdmin() || hodDeletes();
    }

    // ---------- Department setup (HOD of the department writes, logged-in users read) ----------
    match /batches/{id} {
      allow read: if anyUser();
      allow create: if hodCreates();
      allow update: if hodUpdates() || claimsLegacy();
      allow delete: if hodDeletes();
    }
    // A subject's batch must belong to the same department
    function subjectBatchOk() {
      let s = request.resource.data;
      return get(doc("batches", string(s.batchId) + "_" + string(s.semester))).data.get("departmentId", "") == s.departmentId;
    }
    match /subjects/{id} {
      allow read: if anyUser();
      allow create: if hodCreates() && subjectBatchOk();
      allow update: if (hodUpdates() && subjectBatchOk()) || claimsLegacy();
      allow delete: if hodDeletes();
    }
    // Enrollments belong to the subject's (offering) department; they may
    // list students of any department.
    match /enrollments/{id} {
      allow read: if anyUser();
      allow create: if hodCreates();
      allow update: if hodUpdates() || claimsLegacy();
      allow delete: if hodDeletes();
    }
    // Only a teacher of the same department can be assigned
    function assignmentTeacherOk() {
      let a = request.resource.data;
      return a.get("teacherId", null) == null
        || get(doc("teachers", a.teacherId)).data.get("departmentId", "") == a.departmentId;
    }
    match /subjectAssignments/{id} {
      allow read: if anyUser();
      allow create: if hodCreates() && assignmentTeacherOk();
      allow update: if (hodUpdates() && assignmentTeacherOk()) || claimsLegacy();
      allow delete: if hodDeletes();
    }

    // Closed days: "<date>" closes the whole institution (Admin);
    // "<departmentId>_<date>" closes one department (its HOD).
    match /dayStatuses/{id} {
      allow read: if anyUser();
      allow create, update: if request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && ((isAdmin() && request.resource.data.get("departmentId", "") == "ALL" && id == request.resource.data.date)
            || (isAdmin() && id == request.resource.data.get("departmentId", "") + "_" + request.resource.data.date
                && exists(doc("departments", request.resource.data.departmentId)))       // upgrade: old closed days
            || (hodCreates() && id == request.resource.data.departmentId + "_" + request.resource.data.date));
      allow delete: if isAdmin() || hodDeletes();
    }

    // ---------- People ----------
    // Staff of any department may read people records: an offering
    // department needs the names of other departments' students.
    match /teachers/{id} {
      allow read: if isStaff() || seesAll();
      allow create: if hodCreates();
      allow update: if hodUpdates() || claimsLegacy();
      allow delete: if hodDeletes();
    }
    match /students/{id} {
      allow read: if isStaff() || seesAll() || (isStudent() && me().studentDocId == id);
      allow create: if hodCreates();
      allow update: if hodUpdates() || claimsLegacy()
        // the student's own login, set up by themselves
        || (request.resource.data.get("uid", "") == request.auth.uid
            && selfSetup(request.resource.data.get("loginId", ""))
            && stubOf(request.resource.data.loginId).studentDocId == id
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid", "loginId"])
            && (resets(request.resource.data.loginId) || resource.data.get("uid", null) == null));
      allow delete: if hodDeletes();
    }

    // ---------- Attendance (create once; short edit window for its teacher) ----------
    function editWindowMinutes() {
      return exists(doc("config", "settings"))
        ? get(doc("config", "settings")).data.get("editWindowMinutes", 60)
        : 60;
    }
    function teacherEditOk() {
      let before = resource.data;
      let after = request.resource.data;
      let ist = before.savedAt + duration.value(330, "m");
      let midnight = timestamp.date(ist.year(), ist.month(), ist.day()) + duration.value(1110, "m");   // 24:00 India time
      return before.get("savedAt", null) is timestamp
        && teaches(before.subjectId)
        && before.markedBy == me().teacherId
        && request.time < before.savedAt + duration.value(editWindowMinutes(), "m")
        && request.time < midnight
        && after.diff(before).affectedKeys().hasOnly(["records", "originalRecords", "editedAt", "editedBy"])
        && after.records.keys().hasOnly(before.records.keys())             // same students,
        && before.records.keys().hasOnly(after.records.keys())             // only their marks change
        && after.originalRecords == before.get("originalRecords", before.records)   // first-saved marks kept
        && after.editedAt == request.time
        && after.editedBy == me().teacherId;
    }
    match /attendance/{docId} {
      allow read: if canReadRecord();
      allow create: if teaches(request.resource.data.subjectId)
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && docId == request.resource.data.subjectId + "_" + request.resource.data.date
        && request.resource.data.records is map
        && request.resource.data.get("departmentId", "") == myDept()
        && request.resource.data.get("savedAt", null) == request.time
        && !("originalRecords" in request.resource.data)
        && classCouldMeet(request.resource.data.subjectId, request.resource.data.date, myDept());
      allow update: if claimsLegacy() || teacherEditOk();
      allow delete: if false;
    }

    // ---------- Daily class summaries (for the Principal's dashboard) ----------
    // "<subjectId>_<date>": who taught, and how many were present / absent / on leave.
    // Written with the attendance (teacher) or recomputed by the department's HOD;
    // the counts must add up to the saved attendance.
    function summaryOk(id) {
      let s = request.resource.data;
      let att = doc("attendance", id);
      return s.keys().hasOnly(["departmentId", "subjectId", "date", "subjectName", "teacherId", "teacherName",
                                "present", "absent", "leave", "markedAt"])
        && id == s.subjectId + "_" + s.date
        && s.present is int && s.absent is int && s.leave is int
        && s.present >= 0 && s.absent >= 0 && s.leave >= 0
        && existsAfter(att)
        && getAfter(att).data.get("departmentId", "") == s.departmentId
        && s.present + s.absent + s.leave == getAfter(att).data.records.size();
    }
    match /classSummaries/{id} {
      allow read: if canReadRecord();
      allow create: if ((teaches(request.resource.data.subjectId) && request.resource.data.departmentId == myDept())
                        || hodCreates())
        && summaryOk(id);
      // the HOD recomputes; the teacher updates it together with an edit of the attendance
      allow update: if (hodUpdates()
                        || (teaches(request.resource.data.subjectId)
                            && resource.data.departmentId == myDept() && request.resource.data.departmentId == myDept()
                            && getAfter(doc("attendance", id)).data.get("editedAt", null) == request.time))
        && summaryOk(id);
      allow delete: if false;
    }

    // ---------- Each student's own copy of their attendance ----------
    // One document per student per subject: "<studentId>_<subjectId>"
    //   { studentId, subjectId, departmentId (the subject's),
    //     days: {date: "Present"|"Absent"}, leaves: {date: leaveType},
    //     corrections: {date: correctedStatus}, last }
    // Written with the attendance itself (teacher), on approval (HOD), or
    // rebuilt from the originals by the HOD. Students read only their own.
    match /studentViews/{viewId} {
      allow read: if canReadRecord()
        || (isStudent() && resource != null && resource.data.studentId == me().studentDocId);
      allow create: if hodCreates() || teacherViewWriteOk(viewId, {}, {}, {});
      allow update: if hodUpdates() || claimsLegacy()
        || (resource.data.get("departmentId", "") == myDept()
            && teacherViewWriteOk(viewId,
                 resource.data.get("days", {}),
                 resource.data.get("leaves", {}),
                 resource.data.get("corrections", {})));
      allow delete: if hodDeletes();
    }

    // ---------- Internal assessment ----------
    // The subject's own teacher, for a subject of their department whose semester is ACTIVE
    function assessmentWriteOk(subjectId, dept) {
      let subject = get(doc("subjects", subjectId)).data;
      return teaches(subjectId)
        && dept is string && dept != "" && dept == myDept()
        && subject.get("departmentId", "") == dept
        && get(doc("batches", string(subject.batchId) + "_" + string(subject.semester))).data.get("status", "") == "ACTIVE";
    }
    function assessmentReadOk(data) {
      return teaches(data.subjectId) || isHodOf(data.get("departmentId", ""));
    }
    match /assessments/{subjectId} {
      allow read: if (resource == null && isStaff()) || (resource != null && assessmentReadOk(resource.data));
      allow create, update: if request.resource.data.subjectId == subjectId
        && request.resource.data.keys().hasOnly(["subjectId", "departmentId", "components", "marks", "final", "updatedAt", "updatedBy"])
        && request.resource.data.components is list
        && request.resource.data.marks is map
        && (resource == null || resource.data.departmentId == request.resource.data.departmentId)
        && assessmentWriteOk(subjectId, request.resource.data.get("departmentId", ""));
      allow delete: if false;
    }
    match /assessmentViews/{viewId} {
      allow read: if (isStudent() && resource != null && resource.data.studentId == me().studentDocId)
        || (resource == null && isStaff())
        || (resource != null && assessmentReadOk(resource.data));
      allow create, update: if request.resource.data.studentId is string
        && viewId == request.resource.data.studentId + "_" + request.resource.data.subjectId
        && request.resource.data.keys().hasOnly(["studentId", "subjectId", "departmentId", "subjectName", "semester", "components", "final", "updatedAt"])
        && (resource == null || resource.data.departmentId == request.resource.data.departmentId)
        && assessmentWriteOk(request.resource.data.subjectId, request.resource.data.get("departmentId", ""));
      allow delete: if false;
    }
    // Append-only: who changed which marks, when (the server's time)
    match /assessmentLog/{id} {
      allow read: if (resource == null && isStaff()) || (resource != null && assessmentReadOk(resource.data));
      allow create: if request.resource.data.byUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.by is string
        && request.resource.data.keys().hasOnly(["subjectId", "departmentId", "at", "by", "byUid", "action", "componentId", "componentName", "changes", "note"])
        && assessmentWriteOk(request.resource.data.subjectId, request.resource.data.get("departmentId", ""));
      allow update, delete: if false;
    }

    match /classCancellations/{docId} {
      allow read: if anyUser();
      allow create: if (teaches(request.resource.data.subjectId) || hodCreates())
        && request.resource.data.get("departmentId", "") == myDept()
        && request.resource.data.subjectId is string
        && request.resource.data.date is string
        && docId == request.resource.data.subjectId + "_" + request.resource.data.date
        && get(doc("subjects", request.resource.data.subjectId)).data.get("departmentId", "") == myDept();
      allow update: if claimsLegacy();
      allow delete: if hodDeletes();
    }

    // ---------- Corrections ----------
    match /correctionRequests/{id} {
      allow read: if canReadRecord();
      allow create: if teaches(request.resource.data.subjectId)
        && request.resource.data.requestedBy == me().teacherId
        && request.resource.data.status == "pending"
        && request.resource.data.get("departmentId", "") == myDept();
      allow update: if hodUpdates() || claimsLegacy();
      allow delete: if false;
    }
    match /attendanceCorrections/{id} {
      allow read: if canReadRecord();
      allow create: if hodCreates();
      allow update: if claimsLegacy();
      allow delete: if false;
    }

    // ---------- Leave ----------
    // A teacher records leave for a student who has an entry in that day's saved
    // attendance of a subject they teach. Leaves are never edited; only the HOD removes one.
    match /leaves/{docId} {
      allow read: if canReadRecord();
      allow create: if teaches(request.resource.data.subjectId)
        && request.resource.data.keys().hasOnly(["subjectId", "departmentId", "date", "studentId", "type", "reference", "markedBy", "markedAt"])
        && request.resource.data.get("departmentId", "") == myDept()
        && request.resource.data.type in ["CASUAL", "MEDICAL", "NCC", "OTHER"]
        && request.resource.data.date is string
        && request.resource.data.studentId is string
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 100
        && request.resource.data.markedBy == me().teacherId
        && docId == request.resource.data.subjectId + "_" + request.resource.data.date + "_" + request.resource.data.studentId
        && exists(doc("attendance", request.resource.data.subjectId + "_" + request.resource.data.date))
        && request.resource.data.studentId in get(doc("attendance", request.resource.data.subjectId + "_" + request.resource.data.date)).data.records;
      allow update: if claimsLegacy();
      allow delete: if hodDeletes();
    }

    // Everything else is denied by default.
  }
}
